# ---- Backend (NÃO comitar o .env real; só este .example com placeholders) ----

# Porta da API
PORT=4000

# Ambiente: development | production
NODE_ENV=development

# Conexão MongoDB. Local (mongod) ou MongoDB Atlas.
#   Local:  mongodb://127.0.0.1:27017/farmadimin
#   Atlas:  mongodb+srv://<user>:<senha>@<cluster>/farmadimin?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/farmadimin

# PostgreSQL (Neon) — banco de compliance/SNGPC. SEGREDO. Vazio = desativado:
# o app sobe normalmente sem Postgres (o MongoDB segue como banco principal).
# Use a string do endpoint POOLED (host com sufixo "-pooler") e mantenha sslmode=require.
#   postgresql://<user>:<senha>@<projeto>-pooler.<regiao>.aws.neon.tech/<db>?sslmode=require
# Pegue em https://console.neon.tech (ou via `neonctl connection-string`).
# NUNCA comite a senha real nem use em variáveis VITE_* (bundle do frontend é público).
DATABASE_URL=

# Segredo para assinar o cookie de sessão. Gere um valor longo e aleatório, ex:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=troque-isto-por-um-valor-longo-e-aleatorio

# Origem(ns) do frontend permitidas no CORS (separe por vírgula se houver mais de uma).
FRONTEND_ORIGIN=http://localhost:5173

# Google OAuth — Client ID (público) do OAuth 2.0 criado no Google Cloud Console.
# Enquanto vazio, o login com Google fica desativado (o backend responde 503 e o
# botão no frontend aparece desabilitado). NÃO é segredo, mas mantenha em .env.
GOOGLE_CLIENT_ID=

# OpenRouter (IA) — SEGREDO. Vazio = IA desativada (a rota /api/ia responde 503).
# Crie a chave em https://openrouter.ai/keys . NUNCA comite a chave real, e NUNCA
# coloque em variáveis VITE_* (o bundle do frontend é público). Só o backend usa.
OPENROUTER_API_KEY=
# Modelo preferido nas análises/cálculos. Padrão: capaz e GRATUITO (sem créditos).
# Com créditos na conta, troque por um pago (ex.: openai/gpt-4o).
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Fallbacks (lista por vírgula): se o preferido cair/limitar, tenta estes em ordem
# com o mesmo contexto. Vazio usa um padrão embutido de modelos gratuitos capazes.
OPENROUTER_FALLBACK_MODELS=
