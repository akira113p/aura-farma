    },
    {
      "id": "a1f0c2d3e4b00017",
      "type": "text",
      "x": 1440,
      "y": 1826,
      "width": 380,
      "height": 92,
      "text": "compliance (SNGPC) no PostgreSQL: precisa de integridade relacional e ACID",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00018",
      "type": "text",
      "x": 1440,
      "y": 1930,
      "width": 380,
      "height": 92,
      "text": "dois bancos convivem: migrar tudo custaria 5-8 semanas; adicionar Postgres custa 2-3",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00019",
      "type": "text",
      "x": 1440,
      "y": 2034,
      "width": 380,
      "height": 92,
      "text": "segredos so no .env (VITE_ nunca recebe segredo)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0001a",
      "type": "text",
      "x": 1440,
      "y": 2138,
      "width": 380,
      "height": 92,
      "text": "cookie httpOnly + Secure + SameSite",
      "color": "4"
    },
