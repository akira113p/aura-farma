{
  "nodes": [
    {
      "id": "a1f0c2d3e4b00000",
      "type": "text",
      "x": 0,
      "y": 5136,
      "width": 420,
      "height": 180,
      "text": "# auraFarma\n\nGestao + compliance para farmacias pequenas\ncom integracao de compras via distribuidora"
    },
    {
      "id": "a1f0c2d3e4b00001",
      "type": "text",
      "x": 540,
      "y": 266,
      "width": 340,
      "height": 92,
      "text": "**Objetivo & Negocio**",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00002",
      "type": "text",
      "x": 980,
      "y": -46,
      "width": 360,
      "height": 92,
      "text": "Resolve burocracia + desorganizacao de farmacias pequenas",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00003",
      "type": "text",
      "x": 980,
      "y": 58,
      "width": 360,
      "height": 92,
      "text": "Modelo SaaS: mensalidade por farmacia",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00004",
      "type": "text",
      "x": 980,
      "y": 162,
      "width": 360,
      "height": 92,
      "text": "Clientes: farmacias pequenas (foco em genericos)",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00005",
      "type": "text",
      "x": 980,
      "y": 318,
      "width": 360,
      "height": 92,
      "text": "Modelo de dois lados",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00006",
      "type": "text",
      "x": 1440,
      "y": 266,
      "width": 380,
      "height": 92,
      "text": "Farmacia: gestao completa + compra facil integrada",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00007",
      "type": "text",
      "x": 1440,
      "y": 370,
      "width": 380,
      "height": 92,
      "text": "Distribuidora: canal de venda digital + visibilidade da demanda",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00008",
      "type": "text",
      "x": 980,
      "y": 474,
      "width": 360,
      "height": 92,
      "text": "Eurofarma: parceria escolar, valor de marca; papel tecnico secundario",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00009",
      "type": "text",
      "x": 980,
      "y": 578,
      "width": 360,
      "height": 92,
      "text": "Integracao de pedidos mira a distribuidora, nao a Eurofarma diretamente",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0000a",
      "type": "text",
      "x": 540,
      "y": 1306,
      "width": 340,
      "height": 92,
      "text": "**Arquitetura**",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0000b",
      "type": "text",
      "x": 980,
      "y": 682,
      "width": 360,
      "height": 92,
      "text": "Frontend: React + TS + Vite",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0000c",
      "type": "text",
      "x": 980,
      "y": 786,
      "width": 360,
      "height": 92,
      "text": "Backend: Node + Express",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0000d",
      "type": "text",
      "x": 980,
      "y": 890,
      "width": 360,
      "height": 92,
      "text": "Banco principal: MongoDB Atlas (auth, estoque, vendas, contagem)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0000e",
      "type": "text",
      "x": 980,
      "y": 994,
      "width": 360,
      "height": 92,
      "text": "Banco de compliance: PostgreSQL Neon (SNGPC, controlados, lotes, receitas)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0000f",
      "type": "text",
      "x": 980,
      "y": 1098,
      "width": 360,
      "height": 92,
      "text": "Auth: cookie httpOnly + bcrypt + Google",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00010",
      "type": "text",
      "x": 980,
      "y": 1202,
      "width": 360,
      "height": 92,
      "text": "Busca: em memoria no Node + Fuse.js",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00011",
      "type": "text",
      "x": 980,
      "y": 1306,
      "width": 360,
      "height": 92,
      "text": "Dados (estoque/vendas/...): 1 doc por produto no Mongo, campos curtos (alias)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00012",
      "type": "text",
      "x": 980,
      "y": 1410,
      "width": 360,
      "height": 92,
      "text": "Carga: GET /api/estado (1 chamada) + rate-limit por usuario",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00013",
      "type": "text",
      "x": 980,
      "y": 1514,
      "width": 360,
      "height": 92,
      "text": "IA: OpenRouter, chave server-side, fluxo de 2 estagios + seletor de escopo",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00014",
      "type": "text",
      "x": 980,
      "y": 1930,
      "width": 360,
      "height": 92,
      "text": "Decisoes",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00015",
      "type": "text",
      "x": 1440,
      "y": 1618,
      "width": 380,
      "height": 92,
      "text": "CSV ANVISA em memoria (nao sobe pro Mongo)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00016",
      "type": "text",
