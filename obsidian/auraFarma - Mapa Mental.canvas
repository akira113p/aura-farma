    },
    {
      "id": "a1f0c2d3e4b00050",
      "type": "text",
      "x": 1440,
      "y": 6402,
      "width": 380,
      "height": 92,
      "text": "entrada automatica de mercadoria por nota fiscal",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00051",
      "type": "text",
      "x": 980,
      "y": 6506,
      "width": 360,
      "height": 92,
      "text": "Alvaras e licencas",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00052",
      "type": "text",
      "x": 1440,
      "y": 6506,
      "width": 380,
      "height": 92,
      "text": "painel de vencimento (sanitario, CRF, funcionamento)",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00053",
      "type": "text",
      "x": 980,
      "y": 6610,
      "width": 360,
      "height": 92,
      "text": "Relatorios CRF",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00054",
      "type": "text",
      "x": 1440,
      "y": 6610,
      "width": 380,
      "height": 92,
      "text": "geracao automatica para o Conselho",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00055",
      "type": "text",
      "x": 980,
      "y": 6714,
      "width": 360,
      "height": 92,
      "text": "Rastreabilidade por lote",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00056",
      "type": "text",
      "x": 1440,
      "y": 6714,
      "width": 380,
      "height": 92,
      "text": "facilita recall de psicotropicos",
      "color": "1"
    },
    {
      "id": "a1f0c2d3e4b00057",
      "type": "text",
      "x": 540,
      "y": 7078,
      "width": 340,
      "height": 92,
      "text": "**Base de medicamentos**",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b00058",
      "type": "text",
      "x": 980,
      "y": 6818,
      "width": 360,
      "height": 92,
      "text": "Fonte: ANVISA (dados abertos)",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b00059",
      "type": "text",
      "x": 980,
      "y": 6922,
      "width": 360,
      "height": 92,
      "text": "11.759 medicamentos (catalogo de busca)",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b0005a",
      "type": "text",
      "x": 980,
      "y": 7026,
      "width": 360,
      "height": 92,
      "text": "Campos: nome, principio ativo, classe, empresa",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b0005b",
      "type": "text",
      "x": 980,
      "y": 7130,
      "width": 360,
      "height": 92,
      "text": "Em memoria no Node (nao no Mongo)",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b0005c",
      "type": "text",
      "x": 980,
      "y": 7234,
      "width": 360,
      "height": 92,
      "text": "Busca fuzzy via Fuse.js (tolera erro de digitacao)",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b0005d",
      "type": "text",
      "x": 980,
      "y": 7338,
      "width": 360,
      "height": 92,
      "text": "Atualizacao: job semanal baixando CSV (planejado)",
      "color": "3"
    },
    {
      "id": "a1f0c2d3e4b0005e",
      "type": "text",
      "x": 540,
      "y": 7858,
      "width": 340,
      "height": 92,
      "text": "**Assistente IA (OpenRouter)**",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0005f",
      "type": "text",
      "x": 980,
      "y": 7442,
      "width": 360,
      "height": 92,
      "text": "Chave fica so no backend; o front nunca a ve",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00060",
      "type": "text",
      "x": 980,
      "y": 7546,
      "width": 360,
      "height": 92,
      "text": "Resumo automatico (texto pronto) no Dashboard e Relatorios",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00061",
      "type": "text",
      "x": 980,
      "y": 7650,
      "width": 360,
      "height": 92,
      "text": "Tela Assistente: 1 pergunta por vez, sem contexto anterior",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00062",
      "type": "text",
      "x": 980,
      "y": 7754,
      "width": 360,
      "height": 92,
      "text": "Historico das respostas so no navegador (localStorage)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00063",
      "type": "text",
      "x": 980,
      "y": 7962,
      "width": 360,
      "height": 92,
      "text": "Fluxo de 2 estagios (mais barato)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00064",
      "type": "text",
      "x": 1440,
      "y": 7858,
      "width": 380,
      "height": 92,
      "text": "IA pequena planeja quais dados buscar",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00065",
      "type": "text",
      "x": 1440,
      "y": 7962,
      "width": 380,
      "height": 92,
      "text": "backend roda consultas escopadas por usuario",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00066",
      "type": "text",
      "x": 1440,
      "y": 8066,
      "width": 380,
      "height": 92,
      "text": "IA principal responde com os dados certos",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00067",
      "type": "text",
      "x": 980,
      "y": 8170,
      "width": 360,
      "height": 92,
      "text": "Seletor de escopo limita onde a IA enxerga (menos erro)",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00068",
      "type": "text",
      "x": 980,
      "y": 8274,
      "width": 360,
      "height": 92,
      "text": "Fallback de modelos: troca de modelo se um falhar",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00069",
      "type": "text",
      "x": 540,
      "y": 8534,
      "width": 340,
      "height": 92,
      "text": "**Pedidos (logistica distribuidora)**",
      "color": "2"
    },
    {
      "id": "a1f0c2d3e4b0006a",
      "type": "text",
      "x": 980,
      "y": 8378,
      "width": 360,
      "height": 92,
      "text": "Demo de reposicao com o distribuidor (Eurofarma como exemplo)",
      "color": "2"
    },
    {
      "id": "a1f0c2d3e4b0006b",
      "type": "text",
      "x": 980,
      "y": 8482,
      "width": 360,
      "height": 92,
      "text": "Sugere quantidade a repor a partir do estoque minimo",
      "color": "2"
    },
    {
      "id": "a1f0c2d3e4b0006c",
      "type": "text",
      "x": 980,
      "y": 8586,
      "width": 360,
      "height": 92,
      "text": "Estagios do pedido: aguardando, confirmado, separacao, entregue",
      "color": "2"
    },
    {
      "id": "a1f0c2d3e4b0006d",
      "type": "text",
      "x": 980,
      "y": 8690,
      "width": 360,
      "height": 92,
      "text": "DIVIDA TECNICA: vive so no navegador (localStorage) - precisa persistir no banco",
      "color": "2"
    },
    {
      "id": "a1f0c2d3e4b0006e",
      "type": "text",
      "x": 540,
      "y": 9210,
      "width": 340,
      "height": 92,
      "text": "**Observabilidade & Monitoramento**",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b0006f",
      "type": "text",
      "x": 980,
      "y": 8794,
      "width": 360,
      "height": 92,
      "text": "Request-ID unico por requisicao (cabecalho X-Request-Id), propagado front->back",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00070",
      "type": "text",
      "x": 980,
      "y": 8898,
      "width": 360,
      "height": 92,
      "text": "Logs estruturados em JSON (1 linha por evento); nivel via LOG_LEVEL",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00071",
      "type": "text",
      "x": 980,
      "y": 9002,
      "width": 360,
      "height": 92,
      "text": "Erros com stack trace completo + contexto no log; nunca na resposta HTTP",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00072",
      "type": "text",
      "x": 980,
      "y": 9106,
      "width": 360,
      "height": 92,
      "text": "/api/health detalhado: ok, status, banco, uptime, memoria, versao",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00073",
      "type": "text",
      "x": 980,
      "y": 9210,
      "width": 360,
      "height": 92,
      "text": "Metricas de performance: tempo (media/p95), memoria, CPU, contadores por status",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00074",
      "type": "text",
      "x": 980,
      "y": 9314,
      "width": 360,
      "height": 92,
      "text": "Query logging com tempo no Mongoose + marca de query lenta",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00075",
      "type": "text",
      "x": 980,
      "y": 9418,
      "width": 360,
      "height": 92,
      "text": "Cache em memoria com tracking de hit/miss",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00076",
      "type": "text",
      "x": 980,
      "y": 9522,
      "width": 360,
      "height": 92,
      "text": "Alertas configuraveis por threshold com cooldown",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00077",
      "type": "text",
      "x": 980,
      "y": 9626,
      "width": 360,
      "height": 92,
      "text": "Deploy health-gated no Render + rollback documentado",
      "color": "4"
    },
    {
      "id": "a1f0c2d3e4b00078",
      "type": "text",
      "x": 540,
      "y": 10094,
      "width": 340,
      "height": 92,
      "text": "**Roadmap & Proximos passos**",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00079",
      "type": "text",
      "x": 980,
      "y": 9730,
      "width": 360,
      "height": 92,
      "text": "Imediato: controle de validade com alertas",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0007a",
      "type": "text",
      "x": 980,
      "y": 9834,
      "width": 360,
      "height": 92,
      "text": "Depois: SNGPC (maior trabalho, PostgreSQL Neon)",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0007b",
      "type": "text",
      "x": 980,
      "y": 9938,
      "width": 360,
      "height": 92,
      "text": "Depois: persistir Pedidos no banco (divida tecnica)",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0007c",
      "type": "text",
      "x": 980,
      "y": 10042,
      "width": 360,
      "height": 92,
      "text": "Validacao: mostrar para donos de farmacias reais (meses 3-4)",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0007d",
      "type": "text",
      "x": 980,
      "y": 10146,
      "width": 360,
      "height": 92,
      "text": "Banca (~6 meses): mostrar que a ideia funciona",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0007e",
      "type": "text",
      "x": 980,
      "y": 10458,
      "width": 360,
      "height": 92,
      "text": "Diferenciais",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b0007f",
      "type": "text",
      "x": 1440,
      "y": 10250,
      "width": 380,
      "height": 92,
      "text": "autenticacao nivel profissional",
      "color": "6"
    },
    {
      "id": "a1f0c2d3e4b00080",
      "type": "text",
      "x": 1440,
      "y": 10354,
      "width": 380,
      "height": 92,
      "text": "base real da ANVISA",
