# Frontend environment variables (Vite exposes only VITE_*-prefixed vars to the client).
# Copy this file to .env.local and adjust as needed.

# Base URL of the future backend API (Node/Express + MongoDB).
# While there is no backend yet, the app uses an in-memory mock data source,
# so this value is unused until VITE_USE_MOCK is set to "false".
VITE_API_BASE_URL=http://localhost:4000/api

# "true"  -> use the in-memory mock data source (default, no backend required)
# "false" -> talk to the real API at VITE_API_BASE_URL
VITE_USE_MOCK=true
